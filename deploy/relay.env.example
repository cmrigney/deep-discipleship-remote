# Copy to /opt/dd-remote/relay.env on the Pi (mode 600).
# Generate the hash with:  docker run --rm -it ddremote-relay hash-password
# Keep the single quotes: they stop Compose from treating the $ in the hash as variables.
RELAY_PASSWORD_HASH='$2a$10$replace.with.output.of.relay.hash-password'
RELAY_TRUST_CF_HEADERS=true
RELAY_LOG_FORMAT=text
